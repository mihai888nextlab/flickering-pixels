# Copy to .env.local and fill in. .env.local is git-ignored.

# Postgres from docker-compose.yml (`docker compose up -d`)
DATABASE_URL=postgres://flicker:flicker@localhost:5432/flickering_pixels

# Better Auth — generate a secret with: npx @better-auth/cli secret  (or any 32+ random chars)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, "Web application")
#   Authorized JavaScript origin:  http://localhost:3000
#   Authorized redirect URI:       http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
