# Copy to .env.production ON THE SERVER and fill in. Never commit .env.production.

# Your domain (DNS A record → the server's IP). No https://, no trailing slash.
DOMAIN=example.com

# Database password. Generate: openssl rand -hex 24   (hex keeps it URL-safe)
POSTGRES_PASSWORD=

# Better Auth signing secret. Generate: openssl rand -base64 32
# Use a NEW one here, not the one from your .env.local.
BETTER_AUTH_SECRET=

# Google OAuth client. In Google Cloud Console add, on the same client or a new one:
#   Authorized JavaScript origin:  https://example.com
#   Authorized redirect URI:       https://example.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: gallery poems
GROQ_API_KEY=

# Optional: parallel IRSA downloads in the SPHEREx backend (lower it on a small server)
SPHEREX_CONCURRENCY=14
